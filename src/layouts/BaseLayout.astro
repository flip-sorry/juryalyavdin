---
/**
 * Port of the per-page `<head>` (identical across all 10 legacy pages plus
 * the orphan head.html) and the reveal/header-class bootstrap (script.js /
 * script-end.js — both 404 on every case-study page today; this replaces
 * them with one small inline script that always loads).
 *
 * `path` drives canonical/og:url explicitly — never `Astro.url`, which
 * yields directory-style URLs that 404 under `build.format:'file'`
 * (red-team blocker fix, see plan).
 *
 * og:image: ONE absolute tag (`site.origin` prefix, same helper as canonical/
 * og:url — required by the OG spec) pointing at `ogimage-fb.jpg`, the
 * largest of the three source images, with its measured actual dimensions
 * (1200x630). Source declared all three ogimage*.jpg files as separate
 * og:image tags with per-tag width/height (incl. a 314-vs-"600x315" comment
 * mismatch on the one now used) — that's a pre-OG-spec pattern for serving
 * different crops to different scrapers, which no longer matters now that
 * every major consumer (Facebook/LinkedIn/Twitter/Slack) accepts one
 * generously-sized image and scales it. All three files stay in public/ —
 * this is a declaration change, not a URL-contract change (ogimage.jpg /
 * ogimage-in.jpg may still be hotlinked directly).
 */
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const { title, description, path, ogType = 'website', noindex = false } = Astro.props;
const canonical = path === '/' ? `${site.origin}/` : `${site.origin}${path}`;
---

<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={`${site.origin}/images/ogimage-fb.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#1E1E1F" />
    <meta name="theme-color" content="#1E1E1F" />

    <link rel="preload" as="font" type="font/woff2" href="/font/Aeonik-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/font/Aeonik-Medium.woff2" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-61W5TLDRRQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-61W5TLDRRQ');
    </script>

    <script is:inline>
      /* Custom GA4 events — schema contract in ANALYTICS.md (names frozen, changes
         additive-only). Clicks are delegated off `document`, so new links need no
         wiring. section_view gets its own IntersectionObserver rather than reusing
         the reveal one below: the reveal observer skips prefers-reduced-motion
         sessions entirely and only watches `.fade-content`, which case-study pages
         don't have. section_id carries no positional prefix — order travels in
         section_index instead, so inserting/reordering sections doesn't rename
         every value after it and break dimension history. */
      (() => {
        const track = (name, params) => { if (window.gtag) window.gtag('event', name, params); };
        const slug = (s) =>
          s.trim().toLowerCase().replace(/^\d+\s*/, '').replace(/[^a-z0-9]+/g, '_')
            .replace(/^_+|_+$/g, '').slice(0, 40) || 'block';
        const locOf = (a) => {
          if (a.closest('footer')) return 'footer';
          if (a.closest('header')) return 'header';
          const section = a.closest('[data-ga-section]');
          if (section) return section.dataset.gaSection;
          return a.closest('.intro') ? 'intro' : 'page';
        };

        const onClick = (e) => {
          if (e.button === 2) return; /* right-click: context menu, not navigation */
          const a = e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          const href = a.getAttribute('href');
          if (href.startsWith('mailto:')) {
            track('contact_click', { link_location: locOf(a) });
          } else if (/cv[^/]*\.pdf($|\?)/.test(href)) {
            /* CV files only — a generic .pdf match would let any future PDF
               (case deck, cover letter) inflate a key event. Other PDFs are
               covered by enhanced measurement's file_download. */
            track('cv_download', {
              file_name: href.split('/').pop().split('?')[0],
              link_location: locOf(a),
            });
          } else if (a.classList.contains('project')) {
            const external = a.hostname && a.hostname !== location.hostname;
            const locked = !external && /\/sorry(\.html)?$/.test(a.pathname);
            /* Internal case pages key on the path slug — it joins to page_path
               and stays stable across title edits. Locked/external cards all
               share one href (or none on-site), so only the title identifies
               them. */
            const title = a.querySelector('h3');
            track('case_open', {
              case_name: external || locked
                ? slug((title || a).textContent)
                : a.pathname.split('/').pop().replace('.html', ''),
              case_target: external ? 'external' : locked ? 'locked' : 'case',
            });
          } else if (a.classList.contains('social-icons-link')) {
            track('social_click', {
              network: (a.hostname || '').replace('www.', '').split('.')[0],
              link_location: locOf(a),
            });
          }
        };
        document.addEventListener('click', onClick);
        document.addEventListener('auxclick', onClick); /* middle-click → background tab */

        /* Page-level depth marks: section_view alone can't say how far into a
           10 000px-tall section (Experience) a visitor got. 90% comes from
           enhanced measurement's scroll event. */
        const marks = [25, 50, 75];
        let pending = false;
        const checkDepth = () => {
          pending = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (max <= 0) return;
          const pct = (window.scrollY / max) * 100;
          while (marks.length && pct >= marks[0]) {
            track('scroll_depth', { percent_scrolled: marks.shift() });
          }
        };
        window.addEventListener('scroll', () => {
          if (!pending) { pending = true; requestAnimationFrame(checkDepth); }
        }, { passive: true });

        document.addEventListener('DOMContentLoaded', () => {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                observer.unobserve(entry.target);
                track('section_view', {
                  section_id: entry.target.dataset.gaSection,
                  section_index: Number(entry.target.dataset.gaIndex),
                });
              });
            },
            { threshold: 0, rootMargin: '0px 0px -15% 0px' }
          );
          document.querySelectorAll('.fade-content, .content-block').forEach((el, i) => {
            const title = el.querySelector('.section-title, .cases-title, .content-title');
            const name = title
              ? title.textContent
              : ((el.firstElementChild && el.firstElementChild.className) || 'block').split(' ')[0];
            el.dataset.gaSection = slug(name);
            el.dataset.gaIndex = i + 1;
            observer.observe(el);
          });
        });
      })();
    </script>

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          if (localStorage.getItem('theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#F6F0E5');
          }
        } catch (e) { /* storage blocked → stay dark */ }
        document.addEventListener('DOMContentLoaded', () => {
          const items = document.querySelectorAll('.fade-content');
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            items.forEach((el) => el.classList.add('is-visible'));
            document.querySelectorAll('video[autoplay]').forEach((video) => {
              video.removeAttribute('autoplay');
              video.removeAttribute('loop');
              video.pause();
            });
            return;
          }
          /* Not a ratio threshold: a block taller than ~6.7x the viewport caps
             its intersection ratio below 0.15 and would never reveal (Cases,
             Experience). The trigger is instead a line 15% of the viewport
             above its bottom edge — uniform for every block height. */
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0, rootMargin: '0px 0px -15% 0px' }
          );
          items.forEach((el) => observer.observe(el));
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
