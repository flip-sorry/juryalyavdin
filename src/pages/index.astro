---
/**
 * Port of index.html. Fixes applied while porting (per plan Phase 4):
 * - "principals" -> "principles" in the Focus section heading.
 * - og:description said "10+ years", the h1 already said "12+" — unified on
 *   "12+" in the single `description` prop BaseLayout feeds to both tags
 *   (2026-07: resynced to LinkedIn — "Staff Product Designer", "14+ years").
 * - "HLearned" -> "Learned" (Yandex, What I've learnt).
 * - "magority" -> "majority" (Rambler Group, intro paragraph).
 * - "afiicient" -> "efficient" (Zelenski, intro paragraph).
 * - "so I move to" -> "so I moved to" (Rambler Group, intro paragraph).
 * - Stripped `?fbclid=...` tracking param from the RIW link (kept the
 *   #section5464 anchor).
 * - The AR Art Gallery / StudyFree cards had `target="_blank"` with no
 *   `rel` — CaseCard's `external` prop fixes that (and every other card)
 *   uniformly.
 * - Dynamic copyright year: SiteFooter computes it at build time.
 * - Inline `style="color: #ccc5ba"` role spans -> ExperienceSlot's own
 *   `.company`/role styling (see that component's header comment).
 * - Hero video: dropped the invalid `width="100%" height="100%"` attrs
 *   (HeroImage's CSS already sizes the slotted video), added `playsinline`.
 *
 * Avatar glow: precomputed dominant color of /images/avatar.webp via
 * scripts/dominant-color.mjs (see OrbitAvatar's header comment for the
 * source algorithm this replaces).
 *
 * Section rhythm: every `.spacer-2` (160px) between top-level sections is
 * now `margin-top: var(--space-section)` on each `.section-block` fade
 * wrapper below (the final one is SiteFooter's own default `spaced` prop).
 * The two `.spacer-1` (64px) gaps before the Focus/Testimonials grids live
 * as `.focus`'s own `margin-top`; the `.spacer-0` (32px) gap before the
 * Experience list lives as `.experience`'s own `margin-top` — both apply
 * uniformly since every section that uses those classes needed the same gap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrbitAvatar from '../components/OrbitAvatar.astro';
import Button from '../components/Button.astro';
import HeroImage from '../components/HeroImage.astro';
import DetailsGrid from '../components/DetailsGrid.astro';
import SectionTitle from '../components/SectionTitle.astro';
import FocusItem from '../components/FocusItem.astro';
import CaseCard from '../components/CaseCard.astro';
import TestimonialItem from '../components/TestimonialItem.astro';
import ExperienceSlot from '../components/ExperienceSlot.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { site } from '../data/site';
import { cases } from '../data/cases';
import { focusPoints } from '../data/focus';
import { testimonials } from '../data/testimonials';
---

<BaseLayout
  title="Jury Alyavdin — Staff Product Designer"
  description="Staff Product Designer with 14+ years of expertise crafting solutions that power startups and streamline enterprises."
  path="/"
  ogType="profile"
>
  <SiteHeader variant="home" />

  <section class="intro">
    <OrbitAvatar image="/images/avatar.webp" topText="Jury Alyavdin" bottomText="Product Designer" glow="#080808" />
    <div class="intro-title">
      <h1>
        Staff Product Designer with 14+ years of expertise in solutions that power startups and streamline
        enterprises
      </h1>
      <div class="bottom-buttons">
        <Button href={`mailto:${site.email}?cc=mail@jalyavdin.ru&subject=Product%20Designer`}>Contact me</Button>
        <Button href="/j-alyavdin-cv.pdf" variant="ghost" download>Download CV</Button>
      </div>
    </div>
  </section>

  <div class="fade-content section-block">
    <HeroImage>
      <video class="hero" controls autoplay loop muted playsinline poster="/hero.png">
        <source src="/hero.mp4" type="video/mp4" />
        Your browser does not support video
      </video>
    </HeroImage>

    <DetailsGrid
      items={[
        { label: 'Services', value: 'Product design, Product Strategy, Illustrations, Branding, Animations, 3D' },
        { label: 'Segments', value: 'Medtech, Fintech, E-com, Selfcare, Health & Fitness, B2B, Media, Education' },
        { label: 'Roles', value: 'Staff Product Designer, Design Manager, Creative Director, Product Owner' },
      ]}
    />
  </div>

  <div class="fade-content section-block">
    <SectionTitle number="01" title="Focus and principles" />
    <section class="focus">
      {focusPoints.map((point) => <FocusItem icon={point.icon} text={point.text} />)}
    </section>
  </div>

  <div class="fade-content section-block">
    <div class="cases">
      <SectionTitle variant="sticky" number="02" title="Case Study" />
      <section class="cases-grid">
        {
          cases.map((item) => (
            <CaseCard
              title={item.title}
              tagline={item.tagline}
              image={item.image}
              href={item.href}
              external={item.external}
              locked={item.locked}
            />
          ))
        }
      </section>
    </div>
  </div>

  <div class="fade-content section-block">
    <SectionTitle number="03" title="Testimonials" />
    <section class="focus">
      {testimonials.map((t) => <TestimonialItem quote={t.quote} author={t.author} href={t.href} />)}
    </section>
  </div>

  <div class="fade-content section-block">
    <SectionTitle number="04" title="Experience" />
    <section class="experience">
      <ExperienceSlot dates={`February 2025 — Current`} company="PandaDoc" role="Staff Product Designer" current>
        <p>
          PandaDoc is the platform where proposals, quotes, and contracts get created, negotiated, and signed. I
          joined to help answer the question every software company faces right now: what does this product
          become in the age of AI?
        </p>
        <p>
          I drive the AI design strategy for the platform — anticipating where generative document creation,
          model training, and metadata are heading, and turning that into experiences people trust. Every dot in
          the story below — design systems, growth, research, scale — turned out to be preparation for this
          chapter.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Drive the AI design strategy for PandaDoc's platform, anticipating industry trends in generative
            document creation, model training, and metadata
          </li>
          <li>
            Lead end-to-end discovery and validation initiatives, translating research insights into on-brand
            product experiences
          </li>
          <li>Partner with product and engineering to take AI concepts from first prototype to shipped feature</li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>Designing for AI means designing for uncertainty — the interface has to earn trust when the output isn't guaranteed</li>
          <li>Working prototypes beat static mockups for aligning teams around ideas that don't exist yet</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot dates={`June 2022 — February 2025`} company="Shares" role="Product Design Lead">
        <p>
          Shares set out to make investing social: a European app where you buy your first stock alongside your
          friends instead of alone. Fresh off a $40M raise, the company needed design to move as fast as its
          roadmap.
        </p>
        <p>
          As Product Design Lead I tied growth, brand, and product into one design strategy — and kept shipping
          while the company expanded from its UK launch to an EU stock-trading licence.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Led the design strategy for growth, turning acquisition and retention opportunities into measurable
            gains in engagement and conversion
          </li>
          <li>Built a scalable design system that kept a fast-moving product consistent across platforms</li>
          <li>
            Shipped experimental products to hunt for new market fit — including{' '}
            <a href="/casestudy/snake.html">a viral waitlist game</a> built for the European launch
          </li>
          <li>Mentored the design team, raising the bar of its craft while the product raced through releases</li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>In fintech, trust is the product — every screen carries regulatory and emotional weight</li>
          <li>Growth design works when it serves users first; retention follows value, not tricks</li>
          <li>Leading a remote team means designing the process as deliberately as the product</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot
        dates={`May 2020 — August 2023`}
        company="Impress"
        role="Founding Product Designer → Product Design Lead"
      >
        <p>
          In 2020 I traded a Moscow tech giant for a Barcelona startup with a bold bet: that straightening teeth
          could work direct-to-consumer, online to clinic. As the founding product designer, I got the thing
          designers dream about — a blank page.
        </p>
        <p>
          Two years in, Impress was heading toward a $125M Series B; by three, design had grown from one person
          with a Figma file into a department of five embedded across the company.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Built the product from scratch, turning customer interviews and journey mapping into a market-fit
            direct-to-consumer service
          </li>
          <li>
            Designed <a href="/casestudy/impress-app.html">an ML-based mobile app</a> that connects patients'
            online journey with offline clinic treatment
          </li>
          <li>Launched the updated main website with a complete acquisition funnel and global localization</li>
          <li>Designed eight back-office products that streamlined clinic operations and cut costs</li>
          <li>Founded the design department: hired, mentored, and grew the team to five designers</li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>As a founding designer, strategy and execution are the same job — you switch between them hourly</li>
          <li>Learned to navigate a global market where healthcare, retail, and tech expectations collide</li>
          <li>Discovered how to build processes non-product teams actually adopt, not just tolerate</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot dates={`March 2017 — August 2020`} company="Yandex" role="Senior Product Designer">
        <p>
          Yandex — the tech giant behind Russia's search, maps, and voice assistant — is where I learned what
          scale really means. I helped found the mobile branch of Yandex.Market, its e-commerce flagship.
        </p>
        <p>
          That branch quadrupled revenue and became the nucleus of the whole e-commerce unit. Along the way I
          went from designing screens to steering the mobile design department — and stepped on stage to tell
          the story.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Led <a href="/casestudy/market.html">the relaunch of the Yandex.Market mobile app</a>, driving a 40%
            increase in user acquisition and a jump in store ratings
          </li>
          <li>Integrated voice-assisted shopping, boosting e-commerce transactions by 20%</li>
          <li>Improved the parcel receiving flow, lifting customer satisfaction by 15%</li>
          <li>Built a company-wide system for collecting user feedback that sharpened service responsiveness</li>
          <li>
            Represented Yandex as a speaker at Russian Internet Week{' '}
            <a href="https://riw.moscow/program/20191213/763#section5464">(RIW)</a>, presenting the product
            relaunch strategy
          </li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>Asking the right questions matters more than having the right answers — that's how real user needs surface</li>
          <li>Became fluent in customer interviews, from screening to customer development</li>
          <li>Learned to test with real service users and let their data shape the prototype</li>
          <li>Found my public voice — presenting ideas to large audiences became a tool, not a fear</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot dates={`May 2016 — March 2017`} company="Rambler Group" role="Product Designer">
        <p>
          Rambler is one of Russia's biggest web portals, a holding whose media services reach millions of
          readers every day.
        </p>
        <p>
          Always drawn to a bigger challenge, I moved to this media giant to design at portfolio scale:
          twelve established services to improve and three brand-new platforms to launch.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Improved major media products like <a href="https://news.rambler.ru/">Rambler News,</a>{' '}
            <a href="https://rns.online/">RNS,</a> <a href="https://www.wmj.ru/">WMJ,</a>{' '}
            <a href="https://lenta.ru/">Lenta,</a> and <a href="https://www.championat.com/">Championat</a> —
            lifting user engagement by 15% and average viewing time by 10%, with a direct boost to ad revenue
          </li>
          <li>
            Rebuilt and relaunched <a href="https://www.ferra.ru/">Ferra</a> and{' '}
            <a href="https://www.passion.ru/">Passion</a>, growing daily active users by 20%
          </li>
          <li>
            Led the transformation of <a href="https://letidor.ru/">Letidor</a>, which grew its user base 25%
            within six months of launch
          </li>
          <li>
            Built and launched Instamedia, a CMS platform for mobile apps that raised editorial efficiency by
            30% and sped up content delivery by 25%
          </li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>Learned to run multiple large-scale projects in parallel without dropping quality</li>
          <li>Sharpened ruthless prioritisation — the survival skill of a fast-paced media environment</li>
          <li>Discovered that pitching an idea well is half of shipping it</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot dates={`April 2016 — May 2016`} company="Zvooq" role="Product Designer">
        <p>
          A two-month sprint at the intersection of my work and my passion: Zvooq, one of Russia's leading legal
          music-streaming services, needed its catalogue to travel beyond the app — so I helped design the way
          out.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Shipped an embedded player that put Zvooq's music on partner sites across the web, growing the user
            base 25% through partner platforms
          </li>
          <li>Reorganised the web platform's information architecture, extending user sessions by 20%</li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>Learned to work hand-in-hand with analytics teams, making design decisions from data</li>
          <li>Got a deep, practical grounding in Scrum and agile collaboration</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot dates={`February 2015 — April 2016`} company="Webinar" role="Product Designer">
        <p>
          At Webinar, Russia's leading platform for webinars and online meetings, I was the only designer in the
          building. Every screen, every flow, every release — mine to own.
        </p>
        <p>
          That pressure turned out to be the best design education I could ask for: relaunch the flagship, ship
          a mobile app from zero, and build a second product on the side.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>
            Relaunched the flagship streaming service <a href="https://webinar.ru/">Webinar.ru</a>, increasing
            user engagement by 30% and cutting churn by 20%
          </li>
          <li>
            Designed and launched a{' '}
            <a href="https://apps.apple.com/ru/app/webinar/id1050809427">mobile application</a> from scratch,
            growing the mobile user base 25% in its first six months
          </li>
          <li>
            Built <a href="https://we.study/">we.study</a>, a new platform for organising training sessions for
            educators and learners
          </li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>Learned to work shoulder-to-shoulder with developers and plan around real release cycles</li>
          <li>Became adept at user funnels, product metrics, and cohort analysis — design decisions backed by numbers</li>
          <li>Discovered how much ownership one designer can carry when there's no one else to hand off to</li>
        </ul>
      </ExperienceSlot>

      <ExperienceSlot
        dates={`December 2013 — February 2015`}
        company="Zelenski (Egencia — Expedia Inc. in Russia)"
        role="Product Designer"
        isLast
      >
        <p>
          Every story has a first chapter. Mine started at Zelenski Corporate Travel Solutions — the exclusive
          Russian partner of Egencia, Expedia's business-travel arm — where I traded freelancing for my first
          product seat.
        </p>
        <p>
          Nine travel services, one designer learning fast alongside marketing and engineering. The habits I
          picked up here — shipping across disciplines, sweating the typography, hitting deadlines — run through
          everything above.
        </p>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">Contributions</Eyebrow>
        <ul class="circle-list">
          <li>Designed across nine travel services, partnering with marketing and development teams</li>
          <li>Helped launch new projects and marketing campaigns that lifted service adoption and engagement</li>
          <li>Improved user interaction across existing services, raising experience quality and satisfaction</li>
        </ul>
        <div style="height: var(--space-5)" />
        <Eyebrow as="h3">What I've learnt</Eyebrow>
        <ul class="circle-list">
          <li>Picked up front-end skills — HTML and CSS — that still shape how I design for the web</li>
          <li>Learned to collaborate with art directors, balancing design coherence with aesthetic ambition</li>
          <li>Built a craft foundation in typography and color that carries from print to product</li>
        </ul>
      </ExperienceSlot>
    </section>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr;
    grid-gap: var(--space-6);
    grid-auto-rows: minmax(0, auto);
    margin: 24vh auto 0;
    max-width: var(--container-narrow);
    padding: 0 var(--container-pad);
    justify-content: center;
  }

  .bottom-buttons {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: center;
    grid-gap: var(--space-3);
    padding: var(--space-6) 0;
  }

  .section-block {
    margin-top: var(--space-section);
  }

  .focus {
    display: grid;
    margin: 0 auto;
    max-width: var(--container-max);
    padding: 0 var(--container-pad);
    grid-template-columns: repeat(3, 1fr);
    grid-gap: var(--space-6);
    grid-auto-rows: minmax(0, auto);
    margin-top: var(--space-7);
  }

  .cases {
    display: flex;
    align-items: baseline;
    margin: 0 auto;
    max-width: var(--container-max);
    padding: 0 var(--container-pad);
  }

  .cases-grid {
    --cases-grid-gap: 12px;
    flex: 760;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: var(--cases-grid-gap);
    grid-auto-rows: minmax(480px, auto);
  }

  .experience {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-pad);
    margin-top: var(--space-5);
  }

  /* Mirrors ContentBlock's .circle-list rules (case studies) — the Experience
     lists are authored in this template, outside that component's scope. */
  .circle-list {
    margin-left: var(--space-5);
    list-style-type: disc;
  }

  @media (max-width: 1160px) {
    .intro {
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 880px) {
    .intro {
      max-width: var(--container-max);
      margin-top: var(--space-2);
    }

    .focus {
      grid-template-columns: repeat(2, 1fr);
    }

    .cases {
      align-items: stretch;
      flex-direction: column;
    }

    .cases-grid {
      margin-top: var(--space-6);
      grid-auto-rows: minmax(420px, auto);
    }
  }

  @media (max-width: 560px) {
    .circle-list {
      margin-left: 0;
      list-style-type: none;
    }

    .bottom-buttons {
      grid-template-columns: 1fr;
      justify-content: start;
      grid-gap: var(--space-3);
      padding: var(--space-6) 0 0;
    }

    .focus {
      grid-template-columns: 1fr;
    }

    .cases-grid {
      margin-top: var(--space-6);
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(460px, auto);
    }
  }

  @media (max-width: 380px) {
    .cases-grid {
      margin-top: var(--space-6);
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(420px, auto);
    }
  }
</style>
