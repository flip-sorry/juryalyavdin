---
/**
 * Throwaway smoke page for CaseStudyLayout — never routed/built
 * (underscore-prefixed). CaseStudyLayout already wraps BaseLayout
 * internally, so it can't nest inside another BaseLayout-wrapped page; this
 * is its own top-level page instead. Delete once Phase 5 migrates real case
 * studies onto this layout.
 */
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import ContentBlock from '../components/ContentBlock.astro';
---

<CaseStudyLayout
  title="Avito smoke test"
  description="Phase 3 CaseStudyLayout smoke test."
  path="/_smoke2"
  h1="How to start a career with Avito App"
  avatarImage="/casestudy/avito/avito-logo.png"
  orbitTop="Avito"
  orbitBottom="C2C Marketplace"
  heroImage="/casestudy/avito/avito-hero.png"
  details={[
    { label: 'Platform', value: 'iOS' },
    { label: 'Role', value: 'Product Designer' },
    { label: 'Date', value: '2019' },
  ]}
>
  <ContentBlock title="Overview">
    <p>Avito.ru is a Russian classified advertisements website with sections devoted to general goods for sale.</p>
  </ContentBlock>
  <ContentBlock title="Problem">
    <p>At the beginning of the career, every job seems similar: low requirements, similar salary.</p>
  </ContentBlock>
</CaseStudyLayout>
