---
/**
 * Port of `.details-grid-two` / `.grid-two-cell`
 * (style/casestudy.css:60-66, 184-193) plus the `.divider` the source always
 * places immediately above it (e.g. casestudy/avito.html:145-146).
 */
import Divider from './Divider.astro';

interface Props {
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<Divider />
<div class="details-grid-two">
  {
    items.map((item) => (
      <div class="grid-two-cell">
        <p class="lead-in">{item.label}</p>
        <p>{item.value}</p>
      </div>
    ))
  }
</div>

<style>
  .details-grid-two {
    padding-top: var(--space-3);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: var(--space-6);
    grid-auto-rows: minmax(0, auto);
  }

  /* Deliberate deviation from the source (style/casestudy.css:184-193), 2026-08:
     the source put each cell in `flex; space-between` here, which sizes every
     row independently — values shared no left edge (measured 135px apart) and
     long label/value pairs double-wrapped into a ragged 2×2 tangle. Keeping the
     stacked label-above-value relationship the wider layouts use makes the
     numbers scannable on a phone, which is the whole point of a stat block. */
  @media (max-width: 380px) {
    .details-grid-two {
      grid-template-columns: 1fr;
      grid-gap: var(--space-3);
    }
  }
</style>
