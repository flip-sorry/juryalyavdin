---
/**
 * Port of `.hero-image` / `.hero` (style/casestudy.css:33-47, <= 880/<= 380
 * in casestudy.css:149-151/180-182) plus `video.hero` (style/layout.css:
 * 111-114, <= 880 override in adaptive.css:22-25) for the slotted hero
 * video, and a bare `.hero` treatment for the run.html YouTube iframe case.
 *
 * `image` renders the component's own background-image `.hero` div (case
 * studies). Omit it and pass a `<video class="hero">` or `<iframe
 * class="hero">` via the default slot instead (index's hero video,
 * run.html's YouTube embed) — `:global` reaches that slotted markup since
 * HeroImage doesn't render it directly.
 */
interface Props {
  image?: string;
  /**
   * `background-position` for the hero fill. Default `center`. Set it when an
   * asset's subject sits off-center: `cover` crops the overflowing axis
   * symmetrically, which severs edge content at phone widths (pepsi's PEPSICO
   * wordmark + KPI row live in the left half). Only the overflowing axis
   * responds — at ≥880 these heroes overflow vertically, so a horizontal
   * value is a no-op there and safe to set unconditionally.
   */
  position?: string;
  /**
   * `background-size` for the hero fill. Default `cover`. Pass `contain` when
   * the asset is a single composed object (a device render) rather than a
   * scene: `cover` crops the overflowing axis, which at phone widths slices a
   * landscape render into an unreadable strip. `contain` letterboxes against
   * the page background instead, keeping the object whole.
   */
  fit?: string;
}

const { image, position, fit } = Astro.props;
const heroVars = [
  `--hero-image: url("${image}")`,
  position && `--hero-pos: ${position}`,
  fit && `--hero-fit: ${fit}`,
]
  .filter(Boolean)
  .join('; ');
---

<section class="hero-image">
  {image ? <div class="hero" style={heroVars} /> : <slot />}
</section>

<style>
  .hero-image {
    margin: 0 auto;
    max-width: var(--container-max);
    height: 620px;
    border-radius: var(--radius-md);
  }

  .hero-image :global(.hero) {
    height: 100%;
    background-image: var(--hero-image);
    /* Was `auto 100%, cover` — the comma made `cover` a phantom second-layer
       value that never applied, so a hero narrower than the band (e.g. a
       1.94:1 image in the 2.2:1 880px band) rendered centered with bare
       background at the sides. Plain `cover` is identical wherever the old
       value worked and fills the band where it gapped. */
    background-size: var(--hero-fit, cover);
    background-position: var(--hero-pos, center);
    background-repeat: no-repeat;
  }

  .hero-image :global(video.hero) {
    width: 100%;
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
  }

  .hero-image :global(iframe.hero) {
    width: 100%;
    border: 0;
  }

  @media (max-width: 880px) {
    .hero-image {
      height: 400px;
      border-radius: 0;
    }

    .hero-image :global(video.hero) {
      border-radius: 0;
      border: none;
    }
  }

  @media (max-width: 380px) {
    .hero-image {
      height: 320px;
    }
  }
</style>
