---
/**
 * Port of `.hero-image` / `.hero` (style/casestudy.css:33-47, <= 880/<= 380
 * in casestudy.css:149-151/180-182) plus `video.hero` (style/layout.css:
 * 111-114, <= 880 override in adaptive.css:22-25) for the slotted hero
 * video, and a bare `.hero` treatment for the run.html YouTube iframe case.
 *
 * `image` renders the component's own background-image `.hero` div (case
 * studies). Omit it and pass a `<video class="hero">` or `<iframe
 * class="hero">` via the default slot instead (index's hero video,
 * run.html's YouTube embed) — `:global` reaches that slotted markup since
 * HeroImage doesn't render it directly.
 */
interface Props {
  image?: string;
}

const { image } = Astro.props;
---

<section class="hero-image">
  {image ? <div class="hero" style={`--hero-image: url("${image}")`} /> : <slot />}
</section>

<style>
  .hero-image {
    margin: 0 auto;
    max-width: var(--container-max);
    height: 620px;
    border-radius: var(--radius-md);
  }

  .hero-image :global(.hero) {
    height: 100%;
    background-image: var(--hero-image);
    background-size: auto 100%, cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-image :global(video.hero) {
    width: 100%;
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
  }

  .hero-image :global(iframe.hero) {
    width: 100%;
    border: 0;
  }

  @media (max-width: 880px) {
    .hero-image {
      height: 400px;
      border-radius: 0;
    }

    .hero-image :global(video.hero) {
      border-radius: 0;
      border: none;
    }
  }

  @media (max-width: 380px) {
    .hero-image {
      height: 320px;
    }
  }
</style>
