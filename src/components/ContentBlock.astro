---
/**
 * Port of `.content-block` / `.content-title` / `.content-text`
 * (style/casestudy.css:73-97, <= 880 override casestudy.css:154-162).
 *
 * Owns `margin-top: var(--space-section)`, replacing the `.spacer-2` div the
 * source places before every content-block. Reuses the shared `.container`
 * utility for the 1160px/24px geometry the source declared inline.
 *
 * Sticky offset reuses `--site-header-height` (SiteHeader's layout contract)
 * + `--space-2` — the source's literal `top: 72px` is exactly 64 (header) +
 * 8. `margin-bottom: 14px` on `.content-title` is one of the plan's snapped
 * outliers -> `--space-3` (16px), the nearest 8pt step.
 *
 * Also carries `.circle-list` (style/layout.css:276-279, <= 560 override
 * adaptive.css:153-156) — every case study nests it inside `.content-text`,
 * so it lives here rather than as its own component or a base.css global.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="container content-block">
  <section class="content-title">
    <h2>{title}</h2>
  </section>
  <section class="content-text">
    <slot />
  </section>
</div>

<style>
  .content-block {
    align-items: baseline;
    display: grid;
    grid-template-columns: 10fr 21fr;
    grid-gap: var(--space-6);
    grid-auto-rows: minmax(0, auto);
    margin-top: var(--space-section);
  }

  .content-title {
    position: sticky;
    top: calc(var(--site-header-height) + var(--space-2));
    margin-bottom: var(--space-3);
  }

  /* Claim-shaped block titles are long sentences; without balancing they strand
     a single word on the last line (matches the h1 treatment in CaseStudyLayout). */
  .content-title h2 {
    text-wrap: balance;
  }

  .content-text :global(p) {
    margin-bottom: var(--space-3);
  }

  /* The global `a` rule (base.css) is written for nav/social/card links: no
     underline, currentColor, inline-block hit area. Prose links inside a
     paragraph need the opposite — a visible affordance, and `inline` so they
     wrap mid-sentence instead of jumping whole to the next line. */
  .content-text :global(a) {
    display: inline;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* An anchor wrapping a figure is a zoom affordance, not prose: the rule above
     would make it inline (collapsing the figure's top margin) and underline it.
     Keep it a plain block so the media keeps its own rhythm. */
  .content-text :global(a:has(.content-media)) {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* ContentMedia's own `p + .content-media` rule gives a figure its 40px
     post-paragraph gap, but that selector needs the media to be the paragraph's
     ADJACENT SIBLING. Wrapping media in an anchor (zoom) or a div (dark plate)
     breaks the adjacency and the figure silently drops to its base 24px — five
     figures across three pages sat 16px tight. Restore it through the wrapper. */
  .content-text :global(p + a .content-media),
  .content-text :global(p + div .content-media) {
    margin-top: calc(var(--space-4) + var(--space-3));
  }

  /* Zoomable figures need a cue that survives without hover — on a phone the
     link is the only route to a dense diagram's content. */
  .content-text :global(.media-note) {
    display: block;
    margin-top: calc(-1 * var(--space-2));
    color: var(--color-accent);
    font-size: var(--text-caption-size);
  }

  .content-text :global(.circle-list) {
    margin-left: var(--space-5);
    list-style-type: disc;
  }

  @media (max-width: 880px) {
    .content-block {
      grid-template-columns: 1fr;
      grid-gap: var(--space-1);
    }

    .content-title {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .content-text :global(.circle-list) {
      margin-left: 0;
      list-style-type: none;
    }
  }
</style>
