---
/**
 * Port of `img.content-image` (style/casestudy.css:99-102, <= 380 override
 * casestudy.css:195-197). Video covers two distinct source patterns found
 * across the 7 case studies:
 *
 * 1. GIF replacements (the majority): converted at build time to `.mp4`/
 *    `.webm` pairs with a `-poster.jpg` first frame (plan Phase 1) — a
 *    silent, controls-less autoplay loop. Default behaviour (`controls`
 *    omitted, `webm` true).
 * 2. Pre-existing native demo clips (impress-app's sol01-03/usertesting,
 *    market's market-custdev): were already `<video controls autoplay
 *    loop>` in source, single `.mp4` only, no poster. Pass `controls`
 *    (drops `muted`/`playsinline` to match source exactly — browsers won't
 *    autoplay an unmuted video without a user gesture, same as today) and
 *    `webm={false}` (no sibling file to source), `poster={false}` (no file
 *    to point at — would 404 otherwise).
 *
 * Sizing uses `aspect-ratio` from numeric width/height instead of the
 * invalid `width="100%"` attribute the source put on `<video>`.
 *
 * Prop convention differs by kind: for `img` (default), `src` is the full
 * path including extension; for `video`, `src` is the base path WITHOUT
 * extension (e.g. `/casestudy/avito/avito-contacts`) — `.webm`/`.mp4` are
 * derived by appending. `poster` defaults to `${src}-poster.jpg`; pass
 * `false` to opt out entirely (no default file) or a string to override.
 */
interface Props {
  src: string;
  alt: string;
  kind?: 'img' | 'video';
  poster?: string | false;
  controls?: boolean;
  webm?: boolean;
  width: number;
  height: number;
}

const { src, alt, kind = 'img', poster, controls = false, webm = true, width, height } = Astro.props;
const ratio = `${width} / ${height}`;
const posterSrc = poster === false ? undefined : (poster ?? `${src}-poster.jpg`);
---

{
  kind === 'video' ? (
    <video
      class="content-media"
      style={`--media-ratio: ${ratio}`}
      autoplay
      loop
      controls={controls}
      muted={!controls}
      playsinline={!controls}
      preload="metadata"
      poster={posterSrc}
      aria-label={alt}
    >
      {webm && <source src={`${src}.webm`} type="video/webm" />}
      <source src={`${src}.mp4`} type="video/mp4" />
    </video>
  ) : (
    <img
      class="content-media"
      style={`--media-ratio: ${ratio}`}
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
    />
  )
}

<style>
  .content-media {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--media-ratio);
    margin: var(--space-4) 0;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 380px) {
    .content-media {
      margin: var(--space-3) 0;
    }
  }
</style>
